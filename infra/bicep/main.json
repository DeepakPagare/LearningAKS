{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.45.15.27210",
      "templateHash": "17550381985026888632"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure Location"
      }
    },
    "aksName": {
      "type": "string",
      "defaultValue": "aks-enterprise",
      "metadata": {
        "description": "AKS Cluster Name"
      }
    },
    "workspaceName": {
      "type": "string",
      "defaultValue": "law-aks-enterprise",
      "metadata": {
        "description": "Existing Log Analytics Workspace Name"
      }
    },
    "vnetResourceGroup": {
      "type": "string",
      "defaultValue": "AdminAppSrc",
      "metadata": {
        "description": "Existing Virtual Network Resource Group"
      }
    },
    "vnetName": {
      "type": "string",
      "defaultValue": "vnet-enterprise",
      "metadata": {
        "description": "Existing Virtual Network Name"
      }
    },
    "subnetName": {
      "type": "string",
      "defaultValue": "aks-subnet",
      "metadata": {
        "description": "Existing AKS Subnet Name"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "deployAKS",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "aksName": {
            "value": "[parameters('aksName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "subnetId": {
            "value": "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('vnetResourceGroup')), 'Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), parameters('subnetName'))]"
          },
          "logAnalyticsWorkspaceId": {
            "value": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.45.15.27210",
              "templateHash": "11821979449403083952"
            }
          },
          "parameters": {
            "aksName": {
              "type": "string",
              "metadata": {
                "description": "AKS Cluster Name"
              }
            },
            "location": {
              "type": "string",
              "metadata": {
                "description": "Azure Location"
              }
            },
            "subnetId": {
              "type": "string",
              "metadata": {
                "description": "Existing AKS Subnet Resource ID"
              }
            },
            "logAnalyticsWorkspaceId": {
              "type": "string",
              "metadata": {
                "description": "Existing Log Analytics Workspace Resource ID"
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.ContainerService/managedClusters",
              "apiVersion": "2024-02-01",
              "name": "[parameters('aksName')]",
              "location": "[parameters('location')]",
              "identity": {
                "type": "SystemAssigned"
              },
              "sku": {
                "name": "Base",
                "tier": "Free"
              },
              "properties": {
                "dnsPrefix": "[parameters('aksName')]",
                "enableRBAC": true,
                "agentPoolProfiles": [
                  {
                    "name": "system",
                    "mode": "System",
                    "count": 1,
                    "vmSize": "Standard_D2s_v3",
                    "osType": "Linux",
                    "osSKU": "Ubuntu",
                    "type": "VirtualMachineScaleSets",
                    "vnetSubnetID": "[parameters('subnetId')]"
                  }
                ],
                "networkProfile": {
                  "networkPlugin": "azure",
                  "loadBalancerSku": "standard",
                  "serviceCidr": "172.20.0.0/16",
                  "dnsServiceIP": "172.20.0.10"
                },
                "addonProfiles": {
                  "omsagent": {
                    "enabled": true,
                    "config": {
                      "logAnalyticsWorkspaceResourceID": "[parameters('logAnalyticsWorkspaceId')]"
                    }
                  }
                }
              }
            }
          ],
          "outputs": {
            "aksId": {
              "type": "string",
              "value": "[resourceId('Microsoft.ContainerService/managedClusters', parameters('aksName'))]"
            },
            "aksName": {
              "type": "string",
              "value": "[parameters('aksName')]"
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "aksClusterName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'deployAKS'), '2025-04-01').outputs.aksName.value]"
    },
    "aksId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'deployAKS'), '2025-04-01').outputs.aksId.value]"
    }
  }
}